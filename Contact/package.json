{
  "name": "finsta-contact-automation",
  "version": "1.0.0",
  "description": "Playwright POM automation framework for Finsta Banking Contact module",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:qa": "cross-env ENV=qa playwright test",
    "test:uat": "cross-env ENV=uat playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:positive": "playwright test --grep @positive",
    "test:no-destructive": "playwright test --grep-invert @destructive",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:api": "playwright test --grep @api",
    "test:accessibility": "playwright test --grep @accessibility",
    "report:show": "playwright show-report reports/html-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "posttest": "npm run allure:generate"
  },
  "keywords": ["playwright", "automation", "pom", "finsta"],
  "author": "QA Automation Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@axe-core/playwright": "^4.10.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "exceljs": "^4.4.0",
    "csv-parse": "^5.5.6",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "winston": "^3.14.2"
  }
}
