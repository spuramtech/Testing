{
  "name": "charge-form-automation",
  "version": "1.0.0",
  "description": "Playwright + POM automation framework for the Loans > Loan Configuration > Charge screen",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:functional": "playwright test --grep @functional",
    "test:negative": "playwright test --grep @negative",
    "test:positive": "playwright test --grep @positive",
    "test:api": "playwright test --grep @api",
    "test:database": "playwright test --grep @database",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:crossbrowser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:destructive": "playwright test --grep @destructive",
    "test:safe": "playwright test --grep-invert @destructive",
    "test:qa": "cross-env ENV=qa playwright test",
    "test:uat": "cross-env ENV=uat playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "report:show": "playwright show-report reports/html-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "codegen": "playwright codegen",
    "lint": "eslint ."
  },
  "keywords": ["playwright", "automation", "pom", "charge", "nbfc"],
  "author": "QA Automation",
  "license": "UNLICENSED",
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@faker-js/faker": "^9.0.0",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.0.6",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.5.6",
    "eslint": "^9.9.0",
    "exceljs": "^4.4.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  }
}
